# ─── Transport ───────────────────────────────────────────────────────────────
# http   — for HTTP gateway deployments (default). Per-request key via the
#          X-Linear-Api-Key header; a request with no header gets 401. There is
#          no fallback to LINEAR_API_KEY below on this path.
# stdio  — for Claude Desktop / local CLI use only (single user, no gateway)
MCP_TRANSPORT=http

# Port for HTTP transport (default: 8080)
# MCP_HTTP_PORT=8080

# Host for HTTP transport (default: 0.0.0.0)
# MCP_HTTP_HOST=0.0.0.0

# ─── Linear Credentials ─────────────────────────────────────────────────────
# Only used when MCP_TRANSPORT=stdio (local dev / Claude Desktop). Ignored
# entirely by the HTTP/gateway transport — see note above.
# Get your personal API key from: Linear -> Settings -> Security & access -> Personal API keys
LINEAR_API_KEY=lin_api_xxx

# Optional: override the default Linear GraphQL endpoint
# LINEAR_BASE_URL=https://api.linear.app/graphql
